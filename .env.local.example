# 이 파일을 .env.local로 복사한 뒤 키를 넣으세요. .env.local은 zip이나 깃에 올리지 마세요.
# 키 발급: Google AI Studio (https://aistudio.google.com/apikey)
# Vercel에 배포할 때는 이 파일 대신 Project Settings → Environment Variables에 같은 이름으로 넣습니다.
GEMINI_API_KEY=
# 모델을 바꾸고 싶을 때만 수정하세요.
GEMINI_MODEL=gemini-3.5-flash-lite

# ---------- 로그인과 DB (없으면 로그인 버튼이 숨고, 기록은 브라우저에만 저장돼요) ----------
# PostgreSQL 주소. 로컬은 `npm run db:up`(Docker)으로 띄운 아래 주소를 그대로 쓰고, 처음 한 번 `npm run db:migrate`로 표를 만드세요.
# 배포할 때는 호스팅한 PostgreSQL 주소를 넣고, 거기에도 `DATABASE_URL=... npm run db:migrate`를 한 번 실행하세요.
DATABASE_URL=postgres://chameleon:chameleon@127.0.0.1:5432/chameleon
# 로그인 쿠키 서명 키. 32자 이상 아무 값. 만들기: openssl rand -base64 48
SESSION_SECRET=
